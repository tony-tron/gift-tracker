rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Personal user workspace synced across Android phone and Googlebook
    match /workspaces/{workspaceId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == workspaceId;
    }

    // Collaborative live shared wishlists (one unlisted link per group/occasion)
    match /shared_wishlists/{shareId} {
      allow get: if true;
      allow create: if request.auth != null && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;

      // Secret collaborative claims checklist — strictly hidden from the wishlist owner!
      match /claims/{wishId} {
        function ownerUid() {
          return get(/databases/$(database)/documents/shared_wishlists/$(shareId)).data.ownerUid;
        }

        allow read: if request.auth == null || request.auth.uid != ownerUid();
        allow create, update: if (request.auth == null || request.auth.uid != ownerUid())
          && request.resource.data.claimedBy is string
          && request.resource.data.claimedBy.size() > 0
          && request.resource.data.claimedBy.size() <= 80;
        allow delete: if true;
      }
    }
  }
}
